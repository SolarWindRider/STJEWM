\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Event-alignment visualisation on \texttt  {cheetah}.} Top row: per-step observation event-strength $\|\Delta o_t\|$ (orange); rows 2--4: per-step latent first-difference $\|\Delta z_t\|$ for STJEWM-trace (green), LeWM-v2 (purple), and MLP-collapse-control (red). STJEWM-trace aligns latent-change peaks with observation-event peaks ($\rho \approx 0.84$). LeWM-v2 has a high-mean, low-correlation latent that drifts even when the observation is stationary ($\rho \approx 0.61$, latent amplification $\sim 30\times $). GRU is flat-on-purpose ($\mathrm  {resp}\,30\times $, $\rho = 0.06$). MLP collapse-control is literally flat (constant latent by definition, $\rho \approx -0.03$). Two DMC environments (\texttt  {cheetah}, \texttt  {finger}) are visualised across one 500-step random-policy trajectory; the figure is a synthetic illustrative rendering; per-time traces for \texttt  {finger}, \texttt  {ball\_in\_cup}, \texttt  {walker}, etc.\ are in Supplementary Appendix E.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:event-align}{{2}{15}{\textbf {Event-alignment visualisation on \texttt {cheetah}.} Top row: per-step observation event-strength $\|\Delta o_t\|$ (orange); rows 2--4: per-step latent first-difference $\|\Delta z_t\|$ for STJEWM-trace (green), LeWM-v2 (purple), and MLP-collapse-control (red). STJEWM-trace aligns latent-change peaks with observation-event peaks ($\rho \approx 0.84$). LeWM-v2 has a high-mean, low-correlation latent that drifts even when the observation is stationary ($\rho \approx 0.61$, latent amplification $\sim 30\times $). GRU is flat-on-purpose ($\mathrm {resp}\,30\times $, $\rho = 0.06$). MLP collapse-control is literally flat (constant latent by definition, $\rho \approx -0.03$). Two DMC environments (\texttt {cheetah}, \texttt {finger}) are visualised across one 500-step random-policy trajectory; the figure is a synthetic illustrative rendering; per-time traces for \texttt {finger}, \texttt {ball\_in\_cup}, \texttt {walker}, etc.\ are in Supplementary Appendix E}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Specialist summary heatmap (13 models $\times $ 6 metrics).} Rows grouped by family: STJEWM 6-row block (green), SNN baselines (blue), non-SNN baselines (red). Columns left-to-right: env-SR std (20 envs); env-SR stress (4 stress envs); LeWM-SR std; LeWM-SR stress; event-probe AUROC; event-align $\rho $. Greener cells are better on every column. STJEWM-trace is rank-1 tied on stress LeWM-SR; STJEWM-spike is rank-1 on event-probe AUROC ($0.699$); STJEWM-trace is rank-2 ($\rho = 0.626$) on event-align $\rho $ behind SLT-free ($0.640$). MLP LeWM-SR $98.0$\% is a collapse artefact (div $0.0002$).}}{16}{figure.3}\protected@file@percent }
\newlabel{fig:specialist-heatmap}{{3}{16}{\textbf {Specialist summary heatmap (13 models $\times $ 6 metrics).} Rows grouped by family: STJEWM 6-row block (green), SNN baselines (blue), non-SNN baselines (red). Columns left-to-right: env-SR std (20 envs); env-SR stress (4 stress envs); LeWM-SR std; LeWM-SR stress; event-probe AUROC; event-align $\rho $. Greener cells are better on every column. STJEWM-trace is rank-1 tied on stress LeWM-SR; STJEWM-spike is rank-1 on event-probe AUROC ($0.699$); STJEWM-trace is rank-2 ($\rho = 0.626$) on event-align $\rho $ behind SLT-free ($0.640$). MLP LeWM-SR $98.0$\% is a collapse artefact (div $0.0002$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Metric pathology on the G16 generalist suite.} Two questions must be asked together: \emph  {how often is the latent close to the goal latent?} (LeWM-SR) and \emph  {how often does the latent move at all?} (divergence). MLP scores high on the first and zero on the second --- that is not a model that can plan. Four clusters separated on the G16 scatter: \textbf  {collapse} (upper-left, MLP, LeWM-SR $95.5$\%, div $0.0002$), \textbf  {noise} (GRU, div $0.007$, $\rho \approx -0.07$), \textbf  {over-reactive} (LeWM-v2, div $0.186 \sim 16\times $ calibrated, $\rho = 0.52$, latent amplifies obs by $\sim 30\times $), and \textbf  {calibrated} (STJEWM family + CuBiFAE + SLT-LIF-MPC, div $0.011 \pm 0.001$, $\rho \geq 0.99$.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:metric-pathology}{{4}{17}{\textbf {Metric pathology on the G16 generalist suite.} Two questions must be asked together: \emph {how often is the latent close to the goal latent?} (LeWM-SR) and \emph {how often does the latent move at all?} (divergence). MLP scores high on the first and zero on the second --- that is not a model that can plan. Four clusters separated on the G16 scatter: \textbf {collapse} (upper-left, MLP, LeWM-SR $95.5$\%, div $0.0002$), \textbf {noise} (GRU, div $0.007$, $\rho \approx -0.07$), \textbf {over-reactive} (LeWM-v2, div $0.186 \sim 16\times $ calibrated, $\rho = 0.52$, latent amplifies obs by $\sim 30\times $), and \textbf {calibrated} (STJEWM family + CuBiFAE + SLT-LIF-MPC, div $0.011 \pm 0.001$, $\rho \geq 0.99$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Three-panel generalist collapse-robust diagnostic (G4 / G8 / G16.) \textbf  {Per-dim std of latent trajectory} ($d$): STJEWM family + CuBiFAE + SLT-LIF-MPC stay in the calibrated band ($0.011 \pm 0.001$) at every task scale; MLP collapse-control is exactly $0.0002$ at every scale (collapse signature is scale-invariant); LeWM-v2 is $\sim 16\times $ calibrated (over-reactive); GRU is normal on $d$ (noise regime). \textbf  {Responsiveness} ($\mathrm  {resp}$): STJEWM family $\approx 0.21$ at every scale; GRU $\approx 30$ ($150\times $ STJEWM); LeWM-v2 $\approx 30$ ($150\times $ STJEWM); MLP $\approx 0.55$. \textbf  {Event-alignment $\rho $}: STJEWM family $\geq 0.99$ at every scale; LeWM-v2 $0.52$; GRU $\rho \approx -0.07$; MLP $\rho \approx 0$. The figure condenses §6.4--§6.6 onto a single visual: the trace dynamics produce calibrated latents that survive the shared-weight generalist regime.}}}{18}{figure.5}\protected@file@percent }
\newlabel{fig:d3}{{5}{18}{\textbf {Three-panel generalist collapse-robust diagnostic (G4 / G8 / G16.) \textbf {Per-dim std of latent trajectory} ($d$): STJEWM family + CuBiFAE + SLT-LIF-MPC stay in the calibrated band ($0.011 \pm 0.001$) at every task scale; MLP collapse-control is exactly $0.0002$ at every scale (collapse signature is scale-invariant); LeWM-v2 is $\sim 16\times $ calibrated (over-reactive); GRU is normal on $d$ (noise regime). \textbf {Responsiveness} ($\mathrm {resp}$): STJEWM family $\approx 0.21$ at every scale; GRU $\approx 30$ ($150\times $ STJEWM); LeWM-v2 $\approx 30$ ($150\times $ STJEWM); MLP $\approx 0.55$. \textbf {Event-alignment $\rho $}: STJEWM family $\geq 0.99$ at every scale; LeWM-v2 $0.52$; GRU $\rho \approx -0.07$; MLP $\rho \approx 0$. The figure condenses §6.4--§6.6 onto a single visual: the trace dynamics produce calibrated latents that survive the shared-weight generalist regime.}}{figure.5}{}}
