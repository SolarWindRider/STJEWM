# ============================================
# ST-JEWM .gitignore
# Push: code + docs + figures only.
# Trained ckpts + raw data live in OBS.
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual envs / conda
venv/
.venv/
env/
miniconda3/

# Data (npz files — too large for git, see OBS for download)
data/
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.pkl.gz

# Trained model checkpoints (too large for git, see OBS)
# BUT: utility aggregate tables + per-cell JSONs are small and should
# be in the repo so the README's `/results/utility/*.md` links resolve.
results/**
!results/utility/
!results/utility/**
# Large regenerated artifacts nested under utility/ remain excluded:
results/utility/**/final.pt
results/utility/**/latent_stats_*.json
results/utility/**/eval_*.json
results/utility/**/align_*.json
# Whitelist only the small per-cell rollups the paper actually links to.
# (v0.7.9: only cross_env_gen, budget_scaling, latent_goal_mpc,
#  latent_env_grad, sample_efficiency, generalist_scaling produce
#  multi-cell rollups worth committing.)
!results/utility/latent_goal_mpc.json
!results/utility/latent_env_grad.json
!results/utility/sample_efficiency.json
!results/utility/generalist_scaling_table.md
!results/utility/budget_scaling_table.md
!results/utility/cross_env_gen_table.md
# Legacy name from before the v0.7.9 rename:
!results/utility/compression_sweep_table.md
!results/utility/latent_goal_mpc_table.md
!results/utility/latent_env_grad_table.md
!results/utility/sample_efficiency_table.md

# Per-cell JSONs that document the headline tables:
!results/utility/cross_env_gen/**/div.json
!results/utility/cross_env_gen/**/resp.json
!results/utility/cross_env_gen/**/rho.json
!results/utility/cross_env_gen/**/env_sr.json
!results/utility/budget_scaling/**/div.json
!results/utility/budget_scaling/**/resp.json
!results/utility/budget_scaling/**/rho.json
!results/utility/budget_scaling/**/env_sr.json

# Exclude large regenerated artifacts:
results/aggregate/gifs/
results/aggregate/eval_logs/
logs/
*.log
nohup.out
*.tmp
*.swp
*.swo

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# MuJoCo log
MUJOCO_LOG.TXT

# Local secrets
.env
*.local

# LaTeX intermediates
*.aux
*.log
*.toc
*.out

# CONFIDENTIAL: Nature Machine Intelligence article — NEVER push to GitHub
# (OBS-only deliverable: obs://lixiang01/STJEWM_NMI/paper/)
paper/nmi_article.tex
paper/nmi_article.pdf
paper/figs/fig1_nmi_protocol.png
paper/figs/fig1_nmi_protocol_gif/*
paper/figs/make_fig1_nmi.py
paper/nmi_*.png
paper/nmi_*.py

# Publish only compiled PDFs on GitHub — never the LaTeX sources
paper/*.tex

# Transient sweep spec files (regenerated by run_*.py)
configs/_compression_sweep_*.json
configs/_cross_env_gen_*.json
configs/_g16_eval_*.json
data/delayed_t_maze_30k_3d.npz
configs/oodc/merged/
results/5m_pixel/
